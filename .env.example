# Neon Postgres (unset is OK for build — only gated pages need it)
DATABASE_URL=

# Auth.js
AUTH_SECRET=            # npx auth secret
AUTH_RESEND_KEY=        # Resend API key (same account as exam.nanoteofficial.me) — also used for access-request notifications, see src/lib/mail.ts
AUTH_RESEND_FROM="NaNote Cyber <cyber@nanoteofficial.me>"

# comma-separated emails that skip approval, get role=admin, AND receive
# a notification email whenever someone submits the /#access request form
ALLOWED_EMAILS=khantee9@gmail.com

# Local dev only: Neon-protocol proxy in front of a local Postgres (see CLAUDE.md)
NEON_LOCAL_PROXY=
